# Timezone used for "today"/date-boundary logic and container clocks.
TZ=Europe/Zurich

# User/group id the backend process runs as after startup (linuxserver-style).
# On the NAS, match the uid/gid that owns your Docker config volumes.
PUID=1000
PGID=1000

# How often (in days) the backend re-polls the Guidle event API.
REFRESH_INTERVAL_DAYS=1

# Host port the frontend (nginx) publishes, for Nginx Proxy Manager to point at.
FRONTEND_PORT=8420

# Where the backend's persistent data (SQLite DB + cached images) lives on the
# host. Defaults to a local ./data folder; on a NAS/Portainer deployment, set
# this to wherever you keep other services' persistent config.
DATA_PATH=./data

# DeepL API key for translating non-English event titles at ingestion time
# (free tier: 500k chars/month, sign up at https://www.deepl.com/pro-api).
# Free-tier keys end in ":fx" and only work against api-free.deepl.com (the
# backend is already pointed there). Leave unset to disable translation
# entirely — original titles only, no DeepL calls, no crash.
DEEPL_API_KEY=

